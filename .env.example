# Fill in paths in your local server environment; never commit real secrets.
CHAT_DEVICE=cuda
BGE_MODEL=/root/autodl-tmp/models/bge-m3
CE_MODEL=/path/to/bge-reranker-v2-m3
CHAT_DATA_DB=/path/to/knowledge.sqlite
LLM_BASE_URL=http://127.0.0.1:8002/v1
LLM_MODEL=qwen-local
LLM_API_KEY=local-placeholder
CHAT_AGENT_MAX_STEPS=3
CHAT_AGENT_MAX_SOURCES=4
CHAT_BATCH_SIZE=1
CHAT_CE_POOL=16
CHAT_MAX_LENGTH=384
